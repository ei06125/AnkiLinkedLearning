{
  "manifest_version": 3,
  "name": "AnkiLinkedLearning",
  "version": "0.1.0",
  "description": "Turn Japanese LinkedIn Learning transcripts into contextual Anki cards.",
  "minimum_chrome_version": "114",
  "permissions": ["activeTab", "scripting", "storage", "sidePanel"],
  "action": { "default_title": "AnkiLinkedLearning" },
  "background": { "service_worker": "SourceCode/apps/extension/background.js" },
  "side_panel": { "default_path": "SourceCode/apps/extension/panel.html" }
}
